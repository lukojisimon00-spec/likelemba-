# =============================================================================
# LIKELEMBA — exemple de variables d'environnement
# -----------------------------------------------------------------------------
# 1. Copiez ce fichier :  cp .env.example .env.local
# 2. Remplacez les valeurs par celles de VOTRE projet Supabase
#    (Supabase > Project Settings > API Keys / Data API).
# 3. Ne publiez JAMAIS .env.local sur GitHub (il est déjà ignoré par Git).
# Ce fichier-ci ne contient aucune vraie clé.
# =============================================================================

# URL du projet Supabase (publique)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publique « publishable » (sb_publishable_…) ou ancienne clé « anon ».
# Elle peut être visible dans le navigateur : la sécurité repose sur RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_remplacez_moi

# Adresse publique du site, utilisée dans les e-mails (confirmation, mot de passe).
# En local : http://localhost:3000 — en production : https://votre-domaine
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mode de paiement. Seule la valeur "simulation" est acceptée dans le MVP.
PAYMENTS_MODE=simulation

# IMPORTANT : la clé secrète Supabase (sb_secret_… / service_role) n'est PAS
# nécessaire pour le MVP. Ne la mettez jamais dans une variable NEXT_PUBLIC_*.
